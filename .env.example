# =============================================================================
# MetaTrader 5 & Quantitative Trading Environment Configuration Template
# Copy this file to .env and fill in your broker credentials
# =============================================================================

# MetaTrader 5 Account Credentials
MT5_LOGIN=12345678
MT5_PASSWORD=your_secure_password_here
MT5_SERVER=YourBroker-Demo
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# Strategy & Execution Parameters
MAGIC_NUMBER=10101
BASE_RISK_PCT=0.0015
MAX_PORTFOLIO_RISK_PCT=0.0060
MAX_DRAWDOWN_LIMIT_PCT=0.0150
POLL_INTERVAL_SEC=15

# Model Checkpoints
CHECKPOINT_PATH=checkpoints/multi_asset/best_multi_asset_epoch=12_val_loss=-0.0248.ckpt

# Dashboard Server Configuration
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
